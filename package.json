{
  "name": "trace",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev": "tsx server/src/api/index.ts",
    "worker": "tsx server/src/worker/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run server/tests/unit.test.ts",
    "test:integration": "vitest run server/tests/api.test.ts server/tests/integration.pipeline.test.ts server/tests/integration.hardening.test.ts",
    "test:e2e": "vitest run server/tests/e2e.fixture.test.ts",
    "test:fixture": "tsx test-fixture/server.ts",
    "lint": "eslint server test-fixture scripts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "scan": "tsx server/src/cli/index.ts scan",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run test:integration && npm run test:e2e",
    "migrate": "tsx server/src/db/migrate.ts",
    "docker:up": "docker compose up -d postgres redis",
    "docker:build": "docker compose build",
    "docker:stack": "docker compose up -d --build",
    "docker:smoke-stack": "docker compose -f docker-compose.smoke.yml up -d --build",
    "docker:down": "docker compose down -v",
    "docker:smoke-down": "docker compose -f docker-compose.smoke.yml down -v",
    "docker:smoke": "tsx scripts/docker-smoke.ts",
    "docker:verify": "npm run docker:smoke-stack && npm run docker:smoke",
    "validate:render": "tsx scripts/validate-render.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@expo/metro-runtime": "~4.0.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@playwright/test": "^1.62.1",
    "@tanstack/react-query": "^5.66.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "axe-core": "^4.13.0",
    "bullmq": "^6.1.1",
    "commander": "^15.0.0",
    "expo": "~52.0.37",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.7",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.17",
    "expo-secure-store": "~14.0.1",
    "expo-splash-screen": "~0.29.22",
    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "~4.0.8",
    "fastify": "^5.12.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.7",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13",
    "tsx": "^4.23.12",
    "vitest": "^4.1.10",
    "zod": "^4.4.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@eslint/js": "^9.20.0",
    "@types/react": "~18.3.12",
    "eslint": "^9.20.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.24.0"
  }
}
