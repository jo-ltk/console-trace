# Server (never put these in EXPO_PUBLIC_* )
DATABASE_URL=postgres://trace:trace@localhost:5432/trace
REDIS_URL=redis://localhost:6379
API_BASE_URL=http://localhost:3001
API_PORT=3001
PORT=3001
NODE_ENV=development
ALLOW_LOCAL_TARGETS=false
CORS_ORIGINS=*
SCAN_MAX_PAGES=20
SCAN_HARD_MAX_PAGES=100
SCAN_MAX_DEPTH=3
SCAN_MAX_DURATION=180000
SCAN_PAGE_TIMEOUT=30000
SCAN_MAX_REQUESTS=500
SCAN_BROWSER_CONCURRENCY=1
SCAN_MAX_SCREENSHOT_BYTES=8000000
SCAN_MAX_RESPONSE_BODY_BYTES=1048576
SCAN_PROBE_MAX_REQUESTS=50
ARTIFACT_DIR=./artifacts
LOG_LEVEL=info
DATABASE_SSL=false

# Expo client — public API origin only. No database or Redis URLs.
# Local: http://localhost:3001
# Production EAS: https://<trace-api>.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:3001

# --- Render (set by Blueprint; do not commit real values) ---
# Shared by trace-api and trace-worker:
#   NODE_ENV=production
#   DATABASE_URL          (from Render Postgres)
#   DATABASE_SSL=true
#   DATABASE_SSL_REJECT_UNAUTHORIZED=false
#   REDIS_URL             (from Render Key Value, often rediss://)
#   ALLOW_LOCAL_TARGETS=false
#   CORS_ORIGINS=         (empty = native Expo only; comma-separated origins for web)
#   ARTIFACT_DIR=/tmp/artifacts
#   SCAN_* limits, LOG_LEVEL
# API only:
#   PORT                  (set by Render)
#   API_PORT              (same as PORT)
#   API_BASE_URL          (RENDER_EXTERNAL_URL)
# Never set DATABASE_URL or REDIS_URL on Expo/EAS.
